+#[cfg(all(feature = "dim3", feature = "experimental-wide-3d-motors"))]
+fn small_motor_scene_uses_wide_rows_with_caps_and_recycled_warmstarts() {
+    use crate::dynamics::solver::WritebackId;
+    use crate::na::SimdValue;
+    use crate::pipeline::PhysicsWorld;
+    use crate::prelude::{GenericJointBuilder, JointAxesMask, JointAxis};
+
+    let mut world = PhysicsWorld::new();
+    world.gravity = Vector::ZERO;
+    world.integration_parameters.warmstart_joints = true;
+    world.integration_parameters.warmstart_coefficient = 0.8;
