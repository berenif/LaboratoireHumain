+            RigidBodyBuilder::dynamic()
+                .translation(Vector::X * x)
+                .can_sleep(false)
+                .additional_solver_iterations(if lane < 2 { 5 } else { 0 })
+        };
+        let x = lane as f32 * 4.0;
+        let (a, _) = world.insert(body(x), ColliderBuilder::ball(0.1));
+        let (b, _) = world.insert(body(x + 1.0), ColliderBuilder::ball(0.1));
+        let mut joint = GenericJointBuilder::new(JointAxesMask::LIN_AXES)
+            .local_anchor1(Vector::X * 0.5)
+            .local_anchor2(-Vector::X * 0.5)
+            .build();
+        joint.set_limits(JointAxis::AngX, [-0.4, 0.4]);
+        joint.set_motor_position(JointAxis::AngX, 0.2, 20.0, 40.0);
+        joint.set_motor_max_force(JointAxis::AngX, 0.6);
+        world.insert_impulse_joint(a, b, joint);
+    }
+    for _ in 0..6 {
+        world.step();
+        let rows = &world
+            .physics_pipeline
+            .staged_solver
+            .joint_constraints
+            .simd_velocity_constraints;
+        assert!(
+            !rows.is_empty(),
+            "small motor scene silently used scalar overflow"
+        );
+        let mut motors = 0;
+        for row in rows {
+            if matches!(row.writeback_id, WritebackId::Motor(_)) {
+                motors += 1;
+                for lane in 0..crate::math::SIMD_WIDTH {
+                    let impulse = row.impulse.extract(lane);
+                    assert!(impulse.is_finite());
+                    assert!(impulse >= row.impulse_bounds[0].extract(lane));
+                    assert!(impulse <= row.impulse_bounds[1].extract(lane));
+                }
+            }
+        }
+        assert!(motors > 0);
+        for (_, body) in world.bodies.iter() {
+            assert!(body.translation().is_finite() && body.angvel().is_finite());
+        }
+    }
+    assert!(!core::mem::needs_drop::<
+        crate::dynamics::solver::JointConstraintBuilderSimd,
+    >());
