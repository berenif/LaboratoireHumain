+fn min_color_joints() -> usize {
+    // The experimental path also targets one articulated body in a WASM
+    // worker. Keep the decision scene-dependent, with the existing coloring
+    // and row-signature checks still enforcing independent lanes.
+    if cfg!(all(
+        feature = "dim3",
+        feature = "experimental-wide-3d-motors"
+    )) {
+        2
+    } else {
+        JOINT_BATCH * LAYOUT_REF_WORKERS / 2
+    }
+}
