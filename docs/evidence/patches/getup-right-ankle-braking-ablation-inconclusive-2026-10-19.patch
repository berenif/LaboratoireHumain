+                for actuator in (0..=21).chain([usize::MAX]) {
+                    let expected = cfg!(feature = "getup-right-ankle-braking-ablation-experiment")
+                        && enabled && (2180..2200).contains(&native)
+                        && qpos == 7 && actuator == 8;
+                    assert_eq!(braking_ablation_active(&p, native, qpos, actuator), expected,
+                        "enabled={enabled}, native={native}, qpos={qpos}, actuator={actuator}");
+                }
+            }
