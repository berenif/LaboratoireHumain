+// A beta=1 GEMM leaves a canonical +0 output tail unchanged when the
+// corresponding RHS tail is zero and its actual coefficient matrix is finite.
+fn coriolis_zero_tail<const POSITIVE_ZERO: bool, R: na::Dim, S: na::Storage<Real, R, Dyn>>(
+    matrix: &na::Matrix<Real, R, Dyn, S>,
+    first: usize,
+) -> bool {
+    matrix
+        .columns(first, matrix.ncols() - first)
+        .iter()
+        .all(|x| {
+            if POSITIVE_ZERO {
+                x.to_bits() == 0
+            } else {
+                *x == 0.0
+            }
+        })
+}
+
+// The caller proves the omitted-tail/coefficient conditions once per stage.
+fn coriolis_gemm_columns<R: na::Dim, C: na::Dim, SO, SA, SB>(
+    output: &mut na::Matrix<Real, R, Dyn, SO>,
+    alpha: Real,
+    coefficient: &na::Matrix<Real, R, C, SA>,
+    rhs: &na::Matrix<Real, C, Dyn, SB>,
+    columns: usize,
+) where
+    SO: na::StorageMut<Real, R, Dyn>,
+    SA: na::Storage<Real, R, C>,
+    SB: na::Storage<Real, C, Dyn>,
+{
+    if columns == output.ncols() || (alpha != 1.0 && alpha != -1.0) {
+        output.gemm(alpha, coefficient, rhs, 1.0);
+    } else {
+        // Keep the original static row/inner dimensions and reduction order.
+        output.columns_mut(0, columns).gemm(
+            alpha,
+            coefficient,
+            &rhs.columns(0, columns),
+            1.0,
+        );
+    }
+}
