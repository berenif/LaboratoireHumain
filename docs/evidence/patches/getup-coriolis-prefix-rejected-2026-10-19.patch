+#[test]
+fn coriolis_prefix_preserves_current_baseline_and_dense_workspace_bits() {
+    for fixed_root in [false, true] {
+        for kinematic in [false, true] {
+            for phase in [0.0, 0.7, -1.3] {
+                let (mut mb, bodies) = fixture_with_root(-0.6, phase, 0, fixed_root);
+                mb.links[3].joint.kinematic = kinematic;
+                for dt in [0.00125 / 25.0, 0.00125 / 10.0, -0.0] {
+                    assert_matrix_and_factor_parity_against::<true, true>(&mb, &bodies, dt);
+                    assert_matrix_and_factor_parity(&mb, &bodies, dt);
+                }
+                mb.update_mass_matrix_impl::<true, true, true>(0.00125 / 25.0, &bodies);
+                assert_matrix_and_factor_parity_against::<true, true>(&mb, &bodies, 0.00125 / 25.0);
+            }
+        }
+    }
+    let (mb, bodies) = fixture(0.4, 0.7, 0);
+    for value in [Real::NAN, Real::INFINITY, Real::MAX * 0.75] {
+        let mut bad_shift = mb.clone();
+        bad_shift.links[3].shift23.x = value;
+        assert_matrix_and_factor_parity_against::<true, true>(&bad_shift, &bodies, 0.00125 / 25.0);
+        let mut early_parent = mb.clone();
+        let end = early_parent.links[2].assembly_id + early_parent.links[2].joint.ndofs();
+        early_parent.body_jacobians[2][(3, end)] = value;
+        assert_matrix_and_factor_parity_against::<true, true>(
+            &early_parent,
+            &bodies,
+            0.00125 / 25.0,
+        );
+    }
+    // Finite primitive values can still produce a nonfinite coefficient.
+    let mut huge_shift = mb.clone();
+    let mut huge_velocity = bodies.clone();
+    huge_shift.links[3].shift02 = Vector::splat(Real::MAX * 0.75);
+    huge_velocity[huge_shift.links[2].rigid_body].vels.angvel = Vector::splat(Real::MAX * 0.75);
+    assert_matrix_and_factor_parity_against::<true, true>(
+        &huge_shift,
+        &huge_velocity,
+        0.00125 / 25.0,
+    );
+}
