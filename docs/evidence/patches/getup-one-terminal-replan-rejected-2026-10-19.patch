@@ -0,0 +1,564 @@
+//! One-replan lifecycle contracts, not physical recovery qualification.
+//! The shared constructor integrates ordinary upright standing only. All
+//! counters, clocks, loads, rates and displaced/collapsed poses used below are
+//! explicitly synthetic. Only the final determinism test advances one real
+//! tick, from an unchanged upright world and an already-bound controller.
+use super::*;
+use serde_json::{json, Value};
+
+fn explicit_profile() -> Profile {
+    Profile {
+        getup_policy_enabled: true,
+        getup_repeated_recovery: Some(GetUpRepeatedRecovery::CompletedCycleOneTerminalReferenceReplanV1),
+        ..Profile::default()
+    }
+}
+
+fn unused_json() -> Value {
+    json!({"format":"one-terminal-reference-fall-replan-v1","used":false,
+        "settled_native_samples":0,"attempted_native_substep":null,"prior_forecast_substeps":0})
+}
+
+#[test]
+fn replan_selector_is_explicit_and_none_and_basic_repeat_keep_legacy_controller_bytes() {
+    let model = Model::canonical().unwrap();
+    let legacy = serde_json::to_value(Controller::new(&model)).unwrap();
+    assert!(legacy.get("terminal_reference_replan").is_none());
+    for mode in [None, Some(GetUpRepeatedRecovery::CompletedCycleConfirmedFallV1)] {
+        let mut profile = Profile::default();
+        profile.getup_repeated_recovery = mode;
+        assert_eq!(serde_json::to_value(Controller::for_profile(&model, &profile)).unwrap(), legacy);
+        let encoded = serde_json::to_value(&profile).unwrap();
+        if mode.is_none() { assert!(encoded.get("getup_repeated_recovery").is_none()); }
+        let decoded: Profile = serde_json::from_value(encoded.clone()).unwrap();
+        assert_eq!(serde_json::to_value(decoded).unwrap(), encoded);
+    }
+    let active = serde_json::to_value(explicit_profile()).unwrap();
+    assert_eq!(active["getup_repeated_recovery"], "completed-cycle-one-terminal-reference-replan-v1");
+    let mut future = active;
+    future["getup_repeated_recovery"] = "future-terminal-replan".into();
+    assert!(serde_json::from_value::<Profile>(future).is_err());
+}
+
+#[test]
+fn optional_replan_state_rejects_null_unknown_fields_formats_and_missing_required_fields() {
+    let model = Model::canonical().unwrap();
+    let baseline = serde_json::to_value(Controller::new(&model)).unwrap();
+    let mut active = baseline.clone();
+    active["terminal_reference_replan"] = unused_json();
+    let restored: Controller = serde_json::from_value(active.clone()).unwrap();
+    assert_eq!(serde_json::to_value(restored).unwrap(), active);
+    for case in ["null", "unknown field", "unknown format", "missing used", "missing count", "missing prior"] {
+        let mut malformed = active.clone();
+        match case {
+            "null" => malformed["terminal_reference_replan"] = Value::Null,
+            "unknown field" => malformed["terminal_reference_replan"]["unbounded_retries"] = 2.into(),
+            "unknown format" => malformed["terminal_reference_replan"]["format"] = "future-format".into(),
+            "missing used" => { malformed["terminal_reference_replan"].as_object_mut().unwrap().remove("used"); }
+            "missing count" => { malformed["terminal_reference_replan"].as_object_mut().unwrap().remove("settled_native_samples"); }
+            "missing prior" => { malformed["terminal_reference_replan"].as_object_mut().unwrap().remove("prior_forecast_substeps"); }
+            _ => unreachable!(),
+        }
+        assert!(serde_json::from_value::<Controller>(malformed).is_err(), "{case}");
+    }
+    assert_eq!(serde_json::to_value(serde_json::from_value::<Controller>(baseline.clone()).unwrap()).unwrap(), baseline);
+}
+
+#[cfg(not(feature = "getup-terminal-replan-experiment"))]
+#[test]
+fn feature_off_refuses_new_profile_factories_without_constructing_a_world() {
+    let expected = "Terminal reference replan requires getup-terminal-replan-experiment";
+    assert_eq!(explicit_profile().validate().unwrap_err(), expected);
+    assert_eq!(Simulation::new_protocol(0.0, explicit_profile(), true).err().unwrap(), expected);
+    assert_eq!(crate::runtime::Runtime::new_getup_fixture_with_profile("back", explicit_profile()).err().unwrap(), expected);
+    let model = Model::canonical().unwrap();
+    let c = Controller::for_profile(&model, &explicit_profile());
+    assert!(!c.terminal_reference_replan_valid(&explicit_profile(), 0));
+}
+
+#[cfg(feature = "getup-terminal-replan-experiment")]
+#[test]
+fn new_feature_requires_policy_and_refuses_early_or_bumpless_profiles() {
+    let expected = "Repeated GetUp recovery requires the source/terminal-balance controller without early or bumpless transfer";
+    let mut disabled = explicit_profile();
+    disabled.getup_policy_enabled = false;
+    assert_eq!(disabled.validate().unwrap_err(), expected);
+    #[cfg(feature = "getup-terminal-base-ready-experiment")]
+    assert_eq!(explicit_profile().validate().unwrap_err(), expected);
+    #[cfg(not(feature = "getup-terminal-base-ready-experiment"))]
+    explicit_profile().validate().unwrap();
+}
