+        let before = world_words(&s);
+        let mut expected = s.profile.clone();
+        expected.getup_policy_enabled = false;
+        expected.getup_repeated_recovery = None;
+        let shadow = fork(&s).unwrap();
+        assert_eq!(world_words(&shadow), before);
+        assert_eq!(serde_json::to_value(&shadow.profile).unwrap(), serde_json::to_value(expected).unwrap());
+        assert!(shadow.getup_controller.is_none());
+        assert_eq!(world_words(&s), before);
+    }
+}
