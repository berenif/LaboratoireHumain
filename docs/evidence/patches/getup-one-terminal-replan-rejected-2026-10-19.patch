+
+    fn packed(s: &Simulation, encoded_controller: Value) -> Vec<u8> {
+        let mut basis = Profile::default();
+        basis.getup_policy_enabled = true;
+        let runtime = crate::runtime::Runtime::new(lh_contracts::Mode::Protocol, 0.0, basis).unwrap();
+        let mut auxiliary = serde_json::to_value(runtime).unwrap();
+        auxiliary["simulation"] = serde_json::to_value(s).unwrap();
+        auxiliary["simulation"]["getup_controller"] = encoded_controller;
+        auxiliary["timeline"]["tick"] = s.tick.into();
+        auxiliary["timeline"]["generation"] = s.generation.into();
+        let world = bincode::DefaultOptions::new().with_fixint_encoding().serialize(&s.world).unwrap();
+        let schema = 1_u32;
+        let auxiliary = auxiliary.to_string();
+        #[cfg(feature = "root-translation-carry-experiment")]
+        let (schema, auxiliary) = {
+            let mut roots: Vec<_> = s.world.multibody_joints.multibodies().map(|m| {
+                let (index, generation) = m.root().rigid_body_handle().into_raw_parts();
+                json!({"root":[index,generation],"state":m.root_translation_integrator_state()})
+            }).collect();
+            roots.sort_by_key(|entry| (entry["root"][0].as_u64(), entry["root"][1].as_u64()));
+            if roots.iter().any(|entry| !entry["state"].is_null()) {
+                (2_u32, json!({"format":"f32-dq-f64-remainder-v1","runtime":auxiliary,"roots":roots}).to_string())
+            } else { (schema, auxiliary) }
+        };
+        bincode::DefaultOptions::new().with_fixint_encoding()
+            .serialize(&(schema, lh_model::CANONICAL_JSON, world, auxiliary)).unwrap()
+    }
