+    #[cfg(feature = "root-translation-carry-experiment")]
+    fn seed_carry(s: &mut Simulation) {
+        let root = *s.world.multibody_joints.rigid_body_link(s.bodies[0]).unwrap();
+        let mb = s.world.multibody_joints.get_multibody_mut(root.multibody).unwrap();
+        mb.set_root_translation_compensation_enabled(true).unwrap();
+        let mut state = mb.root_translation_integrator_state().unwrap();
+        let axis = state.qbits.iter().position(|bits| f32::from_bits(*bits).abs() >= 0.001).unwrap();
+        let q = f32::from_bits(state.qbits[axis]).abs();
+        state.remainderbits[axis] = ((f64::from(f32::from_bits(q.to_bits() + 1)) - f64::from(q)) * 0.25).to_bits();
+        mb.restore_root_translation_integrator_state(state).unwrap();
+    }
