+    not(feature = "getup-terminal-base-ready-experiment")))]
+mod active {
+    use super::*;
+    use super::super::terminal_balance_tests::{settled_geometry, terminal_controller, world_words};
+    use crate::getup::{current_twists, physical_observation};
+    use bincode::Options;
+
+    fn state(c: &Controller) -> Value { serde_json::to_value(&c.terminal_reference_replan).unwrap() }
+
+    fn zero_rates(s: &mut Simulation) {
+        let root = *s.world.multibody_joints.rigid_body_link(s.bodies[0]).unwrap();
+        s.world.multibody_joints.get_multibody_mut(root.multibody).unwrap()
+            .generalized_velocity_mut().fill(0.0);
+    }
+
+    fn root_rate(s: &mut Simulation, index: usize, rate: f32) {
+        zero_rates(s);
+        let root = *s.world.multibody_joints.rigid_body_link(s.bodies[0]).unwrap();
+        s.world.multibody_joints.get_multibody_mut(root.multibody).unwrap()
+            .generalized_velocity_mut()[index] = rate;
+    }
+
+    fn pelvis_height(s: &mut Simulation, height: f32) {
+        let i = s.model.segments.iter().position(|p| p.id == "pelvis").unwrap();
+        let mut position = s.world.bodies[s.bodies[i]].translation();
+        position.y = height + s.support_height();
+        s.world.bodies[s.bodies[i]].set_translation(position, false);
+    }
+
+    fn torso_angle(s: &mut Simulation, angle: f32) {
+        let i = s.model.segments.iter().position(|p| p.id == "torso").unwrap();
+        s.world.bodies[s.bodies[i]].set_rotation(Rotation::from_rotation_x(angle), false);
+    }
+
+    fn scene() -> Simulation {
+        let mut s = settled_geometry();
+        s.profile = explicit_profile();
+        s.substeps_completed = 1_000;
+        s.motion = Motion::Recovering;
+        zero_rates(&mut s);
+        // Counterfactual predicate fixture only, never integrated or offered as
+        // a geometrically admissible fallen body.
+        pelvis_height(&mut s, 0.55);
+        torso_angle(&mut s, 0.0);
+        s
+    }
+
+    fn exhausted(s: &Simulation) -> Controller {
