+                "tilted torso" => { pelvis_height(&mut s, 0.8); torso_angle(&mut s, 1.251); }
+                "upright torso" => { pelvis_height(&mut s, 0.8); torso_angle(&mut s, 1.249); passes = false; }
+                "load below" => { loads.iter_mut().for_each(|v| *v = f32::from_bits(3.0_f32.to_bits() - 1)); passes = false; }
+                "feet only" => {
+                    loads.fill(0.0);
