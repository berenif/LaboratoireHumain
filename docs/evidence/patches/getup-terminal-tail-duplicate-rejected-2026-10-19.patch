@@ -0,0 +1,228 @@
+//! Endpoint-only A/B contracts. These fixtures never integrate a physics world.
+//! Synthetic references and native counters are not recovery qualification.
+use super::*;
+
+fn words(target: &[f32; 25]) -> [u32; 25] {
+    target.map(f32::to_bits)
+}
+
+fn reference_words(reference: &[[f32; 25]]) -> Vec<[u32; 25]> {
+    reference.iter().map(words).collect()
+}
+
+fn synthetic_knots() -> Vec<[f32; 25]> {
+    (0..8)
+        .map(|frame| {
+            std::array::from_fn(|axis| {
+                // Every coordinate varies, including CoM and torso vertical.
+                (axis as f32 - 12.0) * 0.015625
+                    + frame as f32 * 0.0078125
+                    + (frame * frame) as f32 * (axis + 1) as f32 * 0.0001220703125
+            })
+        })
+        .collect()
+}
+
+#[test]
+fn terminal_tail_append_preserves_every_interpolated_word_and_excludes_tail_from_count() {
+    let model = Model::canonical().unwrap();
+    let knots = synthetic_knots();
+    let knot_words = reference_words(&knots);
+    let interpolated = reference::interpolate(&knots, REFERENCE_SPEED).unwrap();
+    let expected_prefix = reference_words(&interpolated);
+    let mut controller = Controller::new(&model);
+    // These are synthetic teacher accounting sentinels, not a teacher rollout.
+    controller.status.teacher_decisions = knots.len() as u32;
+    controller.status.forecast_substeps = knots.len() as u32 * 20;
+    controller.status.teacher_terminal_reached = true;
+    controller.status.reference_seed_matches_real = true;
+    let teacher_accounting = serde_json::to_value(&controller.status).unwrap();
+
+    // Match the production assembly boundary: interpolate, count, then append.
+    controller.reference = interpolated;
+    controller.status.reference_frames = controller.reference.len() as u32;
+    let tail = terminal_tail_target(&controller.reference, &model).unwrap();
+    controller.reference.push(tail);
+
+    assert_eq!(controller.status.reference_frames, 16);
+    assert_eq!(controller.reference.len(), expected_prefix.len() + 1);
+    assert_eq!(
+        reference_words(&controller.reference[..expected_prefix.len()]),
+        expected_prefix
+    );
+    assert_eq!(reference_words(&knots), knot_words);
+    let mut expected_status = teacher_accounting;
+    expected_status["reference_frames"] = controller.status.reference_frames.into();
+    assert_eq!(serde_json::to_value(&controller.status).unwrap(), expected_status);
+    let expected_tail = if cfg!(feature = "getup-terminal-tail-duplicate-experiment") {
+        *controller.reference.get(expected_prefix.len() - 1).unwrap()
+    } else {
+        standing_target(&model)
+    };
+    assert_eq!(words(controller.reference.last().unwrap()), words(&expected_tail));
+}
+
+#[cfg(not(feature = "getup-terminal-tail-duplicate-experiment"))]
+#[test]
+fn terminal_tail_baseline_returns_exact_source_canonical_target() {
+    let model = Model::canonical().unwrap();
+    let expected = words(&standing_target(&model));
+    for reference in [Vec::new(), vec![[123.0; 25]], synthetic_knots()] {
+        assert_eq!(words(&terminal_tail_target(&reference, &model).unwrap()), expected);
+    }
+}
+
+#[cfg(feature = "getup-terminal-tail-duplicate-experiment")]
+#[test]
+fn terminal_tail_candidate_copies_all_twenty_five_words_and_refuses_empty_reference() {
+    let model = Model::canonical().unwrap();
+    assert!(terminal_tail_target(&[], &model).is_err());
+    let mut final_interpolated: [f32; 25] =
+        std::array::from_fn(|axis| f32::from_bits(0x3e00_0001 + axis as u32 * 7));
+    // Bitwise checks cover signed zero and subnormals as well as all target roles.
+    final_interpolated[0] = -0.0;
+    final_interpolated[1] = 0.0;
+    final_interpolated[21] = f32::from_bits(1);
+    final_interpolated[22] = f32::from_bits(0x8000_0001);
+    final_interpolated[23] = -0.0;
+    final_interpolated[24] = f32::MIN_POSITIVE;
+    let reference = [[-3.0; 25], final_interpolated];
+    assert_eq!(
+        words(&terminal_tail_target(&reference, &model).unwrap()),
+        words(&final_interpolated)
+    );
+    assert_ne!(words(&final_interpolated), words(&standing_target(&model)));
+}
+
+fn synthetic_controller(s: &Simulation, reference: Vec<[f32; 25]>, start: u64) -> Controller {
+    let mut controller = Controller::new(&s.model);
+    controller.started_substep = Some(start);
+    controller.impact_substep = Some(start);
+    controller.status.reference_frames = (reference.len() - 1) as u32;
+    controller.reference = reference;
+    controller
+}
+
+#[test]
+fn terminal_tail_both_arms_keep_exact_lookahead_policy_and_holding_clocks_without_integration() {
+    let mut s = Simulation::new_protocol(0.0, Profile::default(), true).unwrap();
+    let physical = super::super::physical_observation(&s).unwrap();
+    let world_before = bincode::serialize(&s.world).unwrap();
+    let poses_before = serde_json::to_value(s.snapshot().segments).unwrap();
+    let interpolated = reference::interpolate(&synthetic_knots(), REFERENCE_SPEED).unwrap();
+    let frame_count = interpolated.len();
+    let final_interpolated = *interpolated.last().unwrap();
+    let canonical = standing_target(&s.model);
+    assert_ne!(words(&final_interpolated), words(&canonical));
+    let mut baseline_reference = interpolated.clone();
+    baseline_reference.push(canonical);
+    let mut candidate_reference = interpolated.clone();
+    candidate_reference.push(final_interpolated);
+    let start = 37;
+    let mut baseline = synthetic_controller(&s, baseline_reference, start);
+    let mut candidate = synthetic_controller(&s, candidate_reference, start);
+    let mut first_difference = None;
+    let mut first_holding = [None; 2];
+    let native_per_policy = u64::from(policy_substeps(s.profile.dt_s).unwrap());
+    assert_eq!(native_per_policy, 20);
+
+    // Only assign synthetic counters and query commands. Never apply or step them.
+    for elapsed in 0..native_per_policy * (frame_count as u64 + 2) {
+        s.substeps_completed = start + elapsed;
+        let index = (elapsed / native_per_policy) as usize;
+        for (arm, controller) in [&mut baseline, &mut candidate].into_iter().enumerate() {
+            let controls = controller.command(&s, &physical).unwrap();
+            assert!(controls.iter().all(|x| x.is_finite()));
+            assert_eq!(controller.status.reference_frames as usize, frame_count);
+            assert_eq!(controller.reference.len(), frame_count + 1);
+            assert_eq!(controller.status.reference_index as usize, index.min(frame_count));
+            assert_eq!(controller.status.policy_decisions as usize, index + 1);
+            assert_eq!(controller.last_decision, Some(index as u64));
+            assert_eq!(controller.holding, index >= frame_count);
+            assert_eq!(controller.status.phase,
+                if index >= frame_count { "slow-holding" } else { "slow-following" });
+            if controller.holding && first_holding[arm].is_none() {
+                first_holding[arm] = Some(elapsed);
+            }
+            let now = &controller.reference[index.min(frame_count)];
+            let ahead = &controller.reference[(index + 5).min(frame_count)];
+            assert_eq!(
+                controller.decision_observation.iter().copied().map(f32::to_bits).collect::<Vec<_>>(),
+                super::super::slow_observation(&physical, now, ahead).map(f32::to_bits).to_vec()
+            );
+        }
+        let baseline_input: Vec<_> = baseline.decision_observation.iter().map(|x| x.to_bits()).collect();
+        let candidate_input: Vec<_> = candidate.decision_observation.iter().map(|x| x.to_bits()).collect();
+        if baseline_input != candidate_input && first_difference.is_none() {
+            first_difference = Some(elapsed);
+        }
+        // Identical until the appended slot enters index+5; now stays identical
+        // until the holding decision itself. Candidate value equality with the
+        // preceding interpolated frame must not move this slot-based boundary.
+        assert_eq!(baseline_input == candidate_input, index + 5 < frame_count);
+        assert_eq!(
+            &baseline_input[67..92] == &candidate_input[67..92],
+            index < frame_count
+        );
+    }
+    assert_eq!(first_difference, Some((frame_count as u64 - 5) * native_per_policy));
+    assert_eq!(first_holding, [Some(frame_count as u64 * native_per_policy); 2]);
+    assert_eq!(baseline.student_decisions.len(), frame_count + 2);
+    assert_eq!(candidate.student_decisions.len(), frame_count + 2);
+    for (a, b) in baseline.student_decisions.iter().zip(&candidate.student_decisions) {
+        assert_eq!(a.native_substep, b.native_substep);
+        assert_eq!(a.holding, b.holding);
+    }
+    assert_eq!(reference_words(&baseline.reference[..frame_count]), reference_words(&interpolated));
+    assert_eq!(reference_words(&candidate.reference[..frame_count]), reference_words(&interpolated));
+    assert_eq!(bincode::serialize(&s.world).unwrap(), world_before);
+    assert_eq!(serde_json::to_value(s.snapshot().segments).unwrap(), poses_before);
+    assert_eq!(s.tick, 0);
+}
+
+#[test]
+fn terminal_tail_append_keeps_all_source_scipy_interpolation_fixtures() {
+    let model = Model::canonical().unwrap();
+    let parity: serde_json::Value =
+        serde_json::from_str(include_str!("../../data/getup-policy/parity.json")).unwrap();
+    let fixtures = parity["splines"].as_array().unwrap();
+    assert_eq!(fixtures.len(), 12);
+    let mut maximum_error = 0.0_f64;
+    for fixture in fixtures {
+        let knots: Vec<[f32; 25]> = serde_json::from_value(fixture["knots"].clone()).unwrap();
+        let mut reference = reference::interpolate(&knots, fixture["speed"].as_f64().unwrap()).unwrap();
+        let original_words = reference_words(&reference);
+        let expected: Vec<Vec<f64>> = serde_json::from_value(fixture["expected"].clone()).unwrap();
+        assert_eq!(reference.len(), expected.len());
+        for (actual, expected) in reference.iter().flatten().zip(expected.iter().flatten()) {
+            maximum_error = maximum_error.max((f64::from(*actual) - expected).abs());
+        }
+        let tail = terminal_tail_target(&reference, &model).unwrap();
+        reference.push(tail);
+        assert_eq!(reference.len(), expected.len() + 1);
+        assert_eq!(reference_words(&reference[..expected.len()]), original_words);
+    }
+    assert!(maximum_error < 1.0e-6, "source spline maximum error {maximum_error}");
+}
+
+#[cfg(feature = "getup-terminal-tail-observer-experiment")]
+#[test]
+fn terminal_tail_build_identity_truthfully_identifies_arm_and_checkpoint_support() {
+    let identity = crate::runtime::Runtime::terminal_tail_build_identity();
+    assert_eq!(identity["experiment"], "terminal-tail-ab-v1");
+    assert_eq!(identity["variant"],
+        if cfg!(feature = "getup-terminal-tail-duplicate-experiment") {
+            "last-interpolated-duplicate"
+        } else { "source-canonical" });
+    assert_eq!(identity["checkpointResumeSupported"],
+        !cfg!(feature = "getup-terminal-tail-duplicate-experiment"));
+}
+
+#[cfg(feature = "getup-terminal-tail-duplicate-experiment")]
+#[test]
+fn terminal_tail_candidate_refuses_checkpoint_resume_before_attempting_decode() {
+    let expected = "Endpoint-only A/B candidate does not support checkpoint resume";
+    for bytes in [b"".as_slice(), b"not a checkpoint".as_slice(), &[0_u8; 64][..]] {
+        assert_eq!(crate::runtime::Runtime::from_getup_checkpoint(bytes).err().unwrap(), expected);
+    }
+}
