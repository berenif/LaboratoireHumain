{
  "name": "laboratoire-humain",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "npm run build && npm start",
    "build": "node scripts/build-rust-browser.mjs",
    "build:pages": "node scripts/build-rust-browser.mjs rust/dist/pages /LaboratoireHumain/",
    "build:rust": "node scripts/build-rust-browser.mjs",
    "setup:rust": "node scripts/setup-rust.mjs",
    "preview:rust": "node scripts/serve-rust-preview.mjs rust/dist/app 5185",
    "start": "node scripts/serve-rust-preview.mjs rust/dist/app 5185",
    "test": "node --test tests/rust-*.test.mjs",
    "test:rust": "node scripts/run-rust-checks.mjs test",
    "lint:rust": "node scripts/run-rust-checks.mjs lint",
    "verify:rust": "node scripts/run-rust-gates.mjs",
    "verify:rust:foundation": "node scripts/run-rust-gates.mjs --foundation",
    "verify:rust:recovery": "node scripts/run-rust-recovery-gates.mjs",
    "verify:rust:recovery:review": "node scripts/finalize-rust-recovery-qualification.mjs",
    "verify:rust:browser": "node scripts/verify-rust-app.mjs",
    "lint": "node scripts/run-rust-checks.mjs lint",
    "preview": "npm start",
    "verify:smoke": "node scripts/smoke-rust-app.mjs"
  },
  "devDependencies": {
    "playwright": "1.57.0"
  },
  "type": "module"
}
