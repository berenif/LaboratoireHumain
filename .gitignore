# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/
/evidence/

# Cargo builds from the workspace and the independently tested vendored engine
/rust/**/target/

# Local diagnostic checkpoints (do not publish)
/docs/checkpoints/
/docs/checkpoint-*.json

# Local Python tools and environments
__pycache__/
*.py[cod]
.venv/
venv/

# Reproducible MuJoCo MVP output and local browser evidence (not public assets).
/web/dist/
/web/proofs/*
# Explicitly approved runtime inputs; keep every other local proof ignored.
!/web/proofs/getup-weak-seed10/
/web/proofs/getup-weak-seed10/*
!/web/proofs/getup-weak-seed10/weak-final.json
!/web/proofs/getup-continuous-slow/
/web/proofs/getup-continuous-slow/*
!/web/proofs/getup-continuous-slow/reference.json
